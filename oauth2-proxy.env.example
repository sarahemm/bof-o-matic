# oauth2-proxy secrets for bof-o-matic. Copy to oauth2-proxy.env and fill in.
# Register the client in Drupal at
# https://registration.hackersconference.org/admin/config/services/consumer
# with redirect URI https://bofs.hackersconference.org/oauth2/callback
# and scopes: openid, email, profile, roles

OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# Must match the 'iss' claim in the ID token. The wiki uses the trailing-slash
# form; if login fails with an issuer mismatch, try it without the slash.
OAUTH2_PROXY_OIDC_ISSUER_URL=https://registration.hackersconference.org/

OAUTH2_PROXY_REDIRECT_URL=https://bofs.hackersconference.org/oauth2/callback

# 32 random bytes, base64: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
